# ─── Secrets & Credentials (NEVER commit these) ──────────────────────────────
**/.env
**/firebase-service-account.json
**/*.keystore
**/*.jks
**/*.p12
**/*.pem

# ─── Python Backend ───────────────────────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/medinow.db
backend/uploads/
backend/scratch/

# ─── Flutter Frontend ─────────────────────────────────────────────────────────
frontend/.dart_tool/
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/.idea/
frontend/*.iml
frontend/**/*.class
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/key.properties
# Large log/debug/build output files in frontend root
frontend/*.txt
frontend/*.log
frontend/hs_err_pid*.log

# ─── Web Admin Panel ──────────────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.env

# ─── APK/AAB Release Binaries (use GitHub Releases instead) ──────────────────
*.apk
*.aab
*.ipa

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*.swo
